# Preferred single URL configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai101

# Optional split configuration (used only when DATABASE_URL is unset)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai101
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# App runtime settings
APP_HOST=0.0.0.0
APP_PORT=8000

# Auth (JWT) settings
# Generate a strong random value for production, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=30

# Email verification. Off by default — enable only once the app build
# that understands the verification flow ships. With the flag on,
# production requires RESEND_API_KEY (Resend HTTP API); unset locally,
# codes are logged instead of sent.
EMAIL_VERIFICATION_REQUIRED=false
RESEND_API_KEY=
EMAIL_FROM=Perpenda <no-reply@perpenda.com>
EMAIL_CODE_TTL_MINUTES=15
EMAIL_CODE_MAX_ATTEMPTS=5
